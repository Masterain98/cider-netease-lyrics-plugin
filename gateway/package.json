{
  "name": "@cider-netease/gateway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cider-netease/shared build && tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --dts --sourcemap --clean",
    "start": "node dist/server.js",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@cider-netease/shared": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@neteasecloudmusicapienhanced/api": "4.40.0",
    "hono": "^4.9.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
